# ==============================================================================
# SkillForge — Python FastAPI AI Microservice & ChromaDB Vector Store
# ==============================================================================
FROM python:3.12-slim

WORKDIR /app

# Install system dependencies if required
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies first (layer caching)
COPY python_service/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy Python microservice source code
COPY python_service/ ./python_service/
COPY rag/ ./rag/

# Create persistent chroma_db directory
RUN mkdir -p /app/chroma_db

WORKDIR /app/python_service

EXPOSE 8000

# Start uvicorn server — ChromaDB indexes automatically on boot via lifespan
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
