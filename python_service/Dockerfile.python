FROM python:3.12-slim

WORKDIR /app

# Install dependencies first (cached layer)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy Python service source
COPY . .

# Copy knowledge base for ChromaDB indexing
# (In Docker Compose, this is overridden by volume mount for live updates)
COPY ../rag/knowledge-base /rag/knowledge-base

# Create persistent chroma_db directory (mounted as volume in production)
RUN mkdir -p /app/chroma_db

EXPOSE 8000

# Start uvicorn — ChromaDB index is built automatically on first startup via lifespan()
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
