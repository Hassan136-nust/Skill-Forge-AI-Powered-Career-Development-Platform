{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --watch server/server.js",
    "start:backend": "node server/server.js",
    "python": "cd python_service && python3 -m uvicorn main:app --host 0.0.0.0 --port 8000",
    "start": "concurrently -n \"FRONTEND,EXPRESS-API,PYTHON-AI\" -c \"cyan,green,magenta\" \"npm run dev\" \"npm run server\" \"npm run python\"",
    "start:all": "concurrently -n \"FRONTEND,EXPRESS-API,PYTHON-AI\" -c \"cyan,green,magenta\" \"npm run dev\" \"npm run server\" \"npm run python\"",
    "dev:all": "concurrently -n \"FRONTEND,EXPRESS-API,PYTHON-AI\" -c \"cyan,green,magenta\" \"npm run dev\" \"npm run server\" \"npm run python\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^13.1.0",
    "google-auth-library": "^11.0.2",
    "groq-sdk": "^1.5.0",
    "gsap": "^3.15.0",
    "html2pdf.js": "^0.14.0",
    "jsonwebtoken": "^9.0.3",
    "lenis": "^1.3.26",
    "lucide-react": "^1.33.0",
    "mongoose": "^9.9.3",
    "nodemailer": "^9.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "vite": "^8.2.0"
  }
}
